# ドメイン直下への配置用。既存ファイルがある場合は上書きせず内容を統合してください。
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# テキスト系は圧縮して配信する（検索インデックスのJSONを含む）。
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml
</IfModule>

# Composer の定義ファイルは公開しない
<FilesMatch "^composer\.(json|lock|phar)$">
  Require all denied
</FilesMatch>

# vendor/ 内はHTTP公開しない（contact.php はファイルシステム経由で読むため影響なし）
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vendor/ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # クリックジャッキングと不要なブラウザ機能を止める（X-Frame-Options は旧ブラウザ用、CSP側と同じ方針）。
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
  # HSTSはHTTPS配信時のみ効く（HTTPでは無視される）。HTTPS証明書の動作確認後に preload 追加も検討する。
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # 静的エクスポートはインラインscript/styleが必須のため unsafe-inline は外せない。外部リソースは使わず自己ホストのみ許可。
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  # HTML・サイトマップ・検索インデックスはビルドごとに変わるので毎回確認させる。
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # 検索インデックスは検索ページのJSが読む内部データ。検索結果には出さない。
  <FilesMatch "^search-index\.[a-z]{2}\.json$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  # _next/static のCSS・JSはファイル名にハッシュが入るため長期キャッシュできる。
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
