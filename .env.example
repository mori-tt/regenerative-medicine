# ビルド/デプロイ対象: github-pages | lolipop | both | none
# ローカル: npm run build:target の対象（both で両方を順にビルド）。
# GitHub Actions: 同名のリポジトリVariableでデプロイ先を切替（未設定は github-pages のみ）。
DEPLOY_TARGET=lolipop
# 正式なドメインのルートURL（末尾 / 不要）
NEXT_PUBLIC_SITE_URL=https://example.com
# GitHub Pagesのリポジトリ配下なら /regenerative-medicine、Lolipopサブドメイン・独自ドメイン直下なら空欄。
NEXT_PUBLIC_BASE_PATH=
# 通常はBASE_PATHから自動生成。CDN等で別URLにする場合のみ指定。
NEXT_PUBLIC_ASSET_PREFIX=
# 準備中は false。公開チェック完了後に true にして再ビルド。
NEXT_PUBLIC_SITE_INDEXABLE=false
# 英語・中国語ページの検索公開。翻訳・医学用語・監修範囲の確認後だけ true。
NEXT_PUBLIC_LOCALIZED_INDEXABLE=false
# 問い合わせ受付先。未設定時は準備中と表示。
NEXT_PUBLIC_CONTACT_EMAIL=
# 公開ページに表示する運営者情報。空欄のまま本番公開しないでください。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
# 編集者情報。未設定時は src/content/site-config.json の値を使用。
NEXT_PUBLIC_EDITOR_NAME=
NEXT_PUBLIC_EDITOR_ADDRESS=
NEXT_PUBLIC_PUBLICATION_MODE=preview
# GitHub Pagesの確認用は all、Lolipopの公開用ビルドは scheduled。
NEXT_PUBLIC_ARTICLE_BUILD_MODE=scheduled
NEXT_PUBLIC_SHOW_PREVIEW_BANNER=false
NEXT_PUBLIC_SHOW_PREPARATION_NOTICES=false
# 書面許諾・資格確認・監修契約後だけ true にする。
NEXT_PUBLIC_MEDICAL_REVIEWER_ENABLED=false
# 監修予定者の限定表示。本人の掲載許諾を得た場合だけ true にする。
NEXT_PUBLIC_MEDICAL_REVIEWER_PLANNED=true

# 以下はLolipop上のPHPが実行時に読む値です。公開ファイルに書かないでください。
# 推奨：deploy/contact-config.example.php を contact-config.php にコピーし、公開フォルダの「外」（例：ホーム直下）に置く。
# デプロイは公開フォルダを丸ごと入れ替えるため、公開フォルダ内の設定は消えます。環境変数を使える環境では下記でも可。
# 設定ファイルの場所を変える場合: CONTACT_CONFIG_FILE=/フルパス/contact-config.php
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=再生医療ガイド
CONTACT_SMTP_HOST=smtp.lolipop.jp
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_SMTP_SECURE=ssl
CONTACT_PHPMAILER_AUTOLOAD=
CONTACT_ALLOWED_ORIGINS=https://saisei-med.com
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=600
CONTACT_ALLOW_NATIVE_MAIL=false

# カラーテーマ: default (緑), orange (オレンジ)
NEXT_PUBLIC_COLOR_THEME=default
