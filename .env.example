# デプロイ先: github-pages | lolipop | both | none
# ローカル: npm run build:target の対象。GitHub Actions: 同名のリポジトリVariableでデプロイ先を切替（未設定は github-pages のみ）。
DEPLOY_TARGET=lolipop

# 正式なドメインのルートURL（末尾 / 不要）
# GitHubでは Lolipop用=LOLIPOP_SITE_URL、Pages用=NEXT_PUBLIC_SITE_URL として登録。
NEXT_PUBLIC_SITE_URL=https://example.com

# 準備中は preview / false を維持。全確認後に production / true へ。
# GitHubでは Lolipop用に LOLIPOP_PUBLICATION_MODE / LOLIPOP_SITE_INDEXABLE / LOLIPOP_LOCALIZED_INDEXABLE として登録。
NEXT_PUBLIC_PUBLICATION_MODE=preview
NEXT_PUBLIC_SITE_INDEXABLE=false
# 英語・中国語ページの検索公開。翻訳・医学用語・監修範囲の確認後だけ true。
NEXT_PUBLIC_LOCALIZED_INDEXABLE=false
# 記事の生成範囲: GitHub Pages確認用は all、Lolipop公開用は scheduled（build:github-pages / build:lolipop が自動設定）
NEXT_PUBLIC_ARTICLE_BUILD_MODE=scheduled

# 本番公開時に必須の運営情報（GitHubでは同名Variablesに登録。空のまま本番ビルドするとエラー）
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# 問い合わせフォームのSMTP等はサーバー側 contact-config.php に書きます（雛形: deploy/contact-config.example.php）。
# GitHub Actionsには登録しません。設定ファイルは公開フォルダの外（例: ホーム直下）に置いてください。
# 細かい調整（監修者表示・バナー・テーマ色・サブディレクトリ配置等）の既定値は src/content/site-config.json で管理。
# 対象別の設定例は deploy/github-pages.env.example / deploy/lolipop.env.example を参照。
#
# ※ GitHub Actions用のSecrets/Variables（LOLIPOP_SSH_*、LOLIPOP_SITE_URL 等）はこのファイルではなく
#   リポジトリの Settings → Secrets and variables で管理します。一覧・登録コマンドは docs/GO-LIVE.md §4-1。
