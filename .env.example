# 正式なドメインのルートURL（末尾 / 不要）
NEXT_PUBLIC_SITE_URL=https://example.com
# GitHub Pagesのリポジトリ配下なら /regenerative-medicine、Lolipopサブドメイン・独自ドメイン直下なら空欄。
NEXT_PUBLIC_BASE_PATH=
# 通常はBASE_PATHから自動生成。CDN等で別URLにする場合のみ指定。
NEXT_PUBLIC_ASSET_PREFIX=
# 準備中は false。公開チェック完了後に true にして再ビルド。
NEXT_PUBLIC_SITE_INDEXABLE=false
# 問い合わせ受付先。未設定時は準備中と表示。
NEXT_PUBLIC_CONTACT_EMAIL=
# 公開ページに表示する運営者情報。空欄のまま本番公開しないでください。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_PUBLICATION_MODE=preview
NEXT_PUBLIC_SHOW_PREVIEW_BANNER=false
NEXT_PUBLIC_SHOW_PREPARATION_NOTICES=false

# 以下はLolipop上のPHPが実行時に読む値です。公開ファイルに書かず、サーバー側で設定してください。
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=再生医療ガイド
CONTACT_SMTP_HOST=smtp.lolipop.jp
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_SMTP_SECURE=ssl
CONTACT_PHPMAILER_AUTOLOAD=
