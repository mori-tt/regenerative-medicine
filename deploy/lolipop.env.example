# Lolipopは予約日到達分の本番用ビルド。
DEPLOY_TARGET=lolipop
NEXT_PUBLIC_SITE_URL=https://saisei-med.com
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ARTICLE_BUILD_MODE=scheduled

# 医学・法務確認が完了するまでは preview / false を維持する。
NEXT_PUBLIC_PUBLICATION_MODE=preview
NEXT_PUBLIC_SITE_INDEXABLE=false

# 全確認後に production / true へ切り替える。
# NEXT_PUBLIC_PUBLICATION_MODE=production
# NEXT_PUBLIC_SITE_INDEXABLE=true
